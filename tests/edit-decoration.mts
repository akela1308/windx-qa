import assert from "node:assert/strict";
import { readFile } from "node:fs/promises";
import { renderToStaticMarkup } from "react-dom/server";
import { signature } from "../experiments/exp1/a/compositions/signature";
import { applyPatch } from "../src/lib/sites/patch";
import { describeChanges, validateEditDoc } from "../src/lib/sites/edit-review";
import { applyDemoEdit } from "../src/lib/sites/demo-edits";
import type { SiteDoc } from "../src/lib/design";

const doc: SiteDoc = JSON.parse(await readFile("docs/experiment-1c/outputs/bike/light.json", "utf8"));
const prompt = await readFile("docs/experiment-1c/prompts/system.md", "utf8");
assert.ok(prompt.includes('"enum":["marker","circle","underline","none"]'), "The model's schema must offer the same undecorated state as the renderer");
const index = doc.sections.findIndex((s) => s.composition === "signature.marked-line");
assert.ok(index >= 0);
const before = structuredClone(doc);
const section = before.sections[index];
section.props = { before: "A small-business site should say what you sell, where you are and", marked: "how to ring you", after: "before anyone has to scroll.", mark: "underline" };
const replacement = { ...section, props: { ...(section.props as Record<string,unknown>), mark: "none" } };
const patched = applyPatch(before, { ops: [{ op: "replace", index, section: replacement }] });
assert.deepEqual(patched.errors, []);
const valid = validateEditDoc(patched.doc, before);
assert.ok(valid.ok, JSON.stringify(valid));
if (!valid.ok) throw new Error("Invalid patch");
assert.deepEqual(valid.doc.sections.filter((_, i) => i !== index), before.sections.filter((_, i) => i !== index));
assert.deepEqual(valid.doc.meta, before.meta); assert.deepEqual(valid.doc.tokens, before.tokens);
const composition = signature["signature.marked-line"];
const props = composition.props.parse(replacement.props);
const html = renderToStaticMarkup(composition.render(props, { tokens: doc.tokens, index }));
assert.ok(html.includes("how to ring you")); assert.ok(!html.includes("<svg")); assert.ok(!html.includes('class="mk"'));
const changes = describeChanges(before, valid.doc);
assert.equal(changes.length, 1); assert.ok(changes[0].layout); assert.equal(changes[0].before, ""); assert.equal(changes[0].after, "");
const russian = applyDemoEdit(doc, "calm-hero", true);
assert.match(russian.reply, /Главный экран/); assert.equal(russian.doc.meta.title, doc.meta.title);
assert.ok(russian.doc.sections.some((s) => JSON.stringify(s.props).includes("Book a service")));
console.log("PASS: decoration removed; exact text, metadata and unrelated sections preserved; review reports styling; Russian reply leaves English site copy");
