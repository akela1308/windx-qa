# Пример настроек. Скопируйте в .env.local и впишите свои значения. .env.local в git не попадает.

# Модель через OpenRouter (openrouter.ai → Keys). Без ключа кабинет работает в демо-режиме.
OPENROUTER_API_KEY=
# Необязательно: другие модели (список: https://openrouter.ai/models)
# AI_MODEL=anthropic/claude-sonnet-5.5
# AI_MODEL_SMALL=anthropic/claude-haiku-5.5
# Отдельная модель первой генерации, без удорожания всех правок (необязательно):
# AI_MODEL_CREATE=anthropic/claude-opus-5.5
# AI_MODEL_EDIT=anthropic/claude-sonnet-5.5
# AI_DEMO=1   # принудительный демо-режим даже при наличии ключа

# Хранилище сайтов (по умолчанию ./data). На Railway: /data
# WINDX_DATA_DIR=
# Общий пароль кабинета (только на хостинге)
# WINDX_DEMO_PASSWORD=
# Почта владельца старых сайтов: резервируется до выдачи персонального приглашения.
# WINDX_OWNER_EMAIL=
# Google Cloud OAuth client, тип Web application. Секрет только на сервере.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# WINDX_AUTH_ORIGIN=https://www.windx.app
# Callback: https://www.windx.app/auth/google/callback
# Гостевой пробный режим: временные лимиты попыток в сутки UTC.
# WINDX_TRIAL_DAILY_PER_IP=3
# WINDX_TRIAL_DAILY_TOTAL=20

# Проверка поиска: 0 отключает исходящие HTTP-пробы в локальных тестах.
# По умолчанию опубликованный сайт проверяется по трём адресам WINDX, без cookies и редиректов.
# WINDX_SEARCH_HTTP=0

# Свои домены: отдельный project token WINDX production, только на сервере.
# Без него можно подготовить TXT, но реальное подключение честно выключено.
# WINDX_DOMAIN_RAILWAY_TOKEN=
# Railway задаёт эти три переменные автоматически; локально нужны только для проверки провайдера:
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_SERVICE_ID=
# Ограничение сервиса целиком, включая *.windx.app. Не повышает тариф или лимит Railway.
# WINDX_RAILWAY_DOMAIN_LIMIT=2

# Служебные письма восстановления/подтверждения. Без настройки интерфейс честно показывает недоступность.
# Railway Hobby не поддерживает SMTP, используем HTTPS API (Resend).
# Аккаунт и подтверждённый отправляющий домен настраиваются отдельно, без автоматической покупки тарифа.
# WINDX_MAIL_PROVIDER=resend
# RESEND_API_KEY=
# WINDX_MAIL_FROM=accounts@your-verified-domain.example
# Ссылки используют WINDX_AUTH_ORIGIN выше; ни Host, ни Forwarded их не задают.
# В Resend отключить open/click tracking для домена служебных писем.
# Локальный тестовый ящик (НИКОГДА не включается с публичным WINDX_AUTH_ORIGIN):
# WINDX_MAIL_PROVIDER=file
# WINDX_MAIL_TEST=1
# WINDX_AUTH_ORIGIN=http://127.0.0.1:3216
