{
  "name": "windx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --import tsx tests/built-styles.mts",
    "start": "next start",
    "lint": "eslint",
    "exp1:prompts": "tsx experiments/exp1/build-prompts.ts",
    "exp1": "tsx experiments/exp1/run.ts",
    "test:e2e": "tsx tests/journey-http.mts",
    "test:journey": "tsx tests/journey-http.mts",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "backup:pull": "node ops/pull-platform-backup.mjs",
