import assert from 'node:assert/strict';
import{readFile}from'node:fs/promises';
import{FONTS}from'../experiments/exp1/a/fonts';
import{getDirection}from'../experiments/exp1/a/directions';
import{templateReference,templateLayoutReference}from'../src/lib/catalog';
import{creationUser}from'../src/lib/ai/operation-plan';
import{assess,layout,pairedLayouts,type Capture,type Expectation}from'../experiments/selection-study/metrics';
const doc=JSON.parse(await readFile('docs/catalog/deep-ink.json','utf8'));
const q={width:1280,height:860,scrollWidth:1280,h1Count:1,forms:0,photoSlots:0,fontLoaded:true,bodyFontLoaded:true,duplicateIds:[],brokenHashes:[]};
const capture:Capture={caseId:'one',phase:'before',business:'test',style:'deep-ink',template:'4',url:'local',preview:'local',colors:doc.tokens.colors,displayFont:FONTS[doc.tokens.displayFont as keyof typeof FONTS].css,bodyFont:FONTS[doc.tokens.bodyFont as keyof typeof FONTS].css,weight:doc.tokens.displayWeight,italic:false,displayCase:'none',radius:doc.tokens.radius,hero:{composition:'hero.statement',align:'center'},sections:doc.sections.map((s:{composition:string})=>({composition:s.composition})),desktop:q,mobile:{...q,width:390,height:844,scrollWidth:390}};
const expected:Expectation={caseId:'one',direction:getDirection('deep-ink')!,reference:{hero:'hero.statement',align:'center',primaryService:'services.disclosure',sequence:doc.sections.map((s:{composition:string})=>s.composition)}};
assert.deepEqual(assess(capture,expected).templateErrors,[]);assert.deepEqual(assess(capture,expected).qualityErrors,[]);assert.ok(assess({...capture,hero:{composition:'hero.statement',align:'left'}},expected).templateErrors.some(x=>x.startsWith('align')),'Matching font/colours cannot hide changed alignment');
assert.ok(assess({...capture,sections:capture.sections.map(s=>s.composition==='services.disclosure'?{composition:'services.ledger'}:s)},expected).templateErrors.some(x=>x.startsWith('primary')));
const auto={...capture,template:undefined};const recolour={...auto,caseId:'two',colors:{...auto.colors,bg:'#132D31'},displayFont:'Unknown Family'};assert.deepEqual(layout(auto),layout(recolour),'Palette and font changes are not layout changes');assert.equal(pairedLayouts([assess(auto,expected),assess(recolour,expected)])[0].distinctMainLayouts,1);assert.ok(assess(recolour,expected).styleErrors.length);
const decor={...auto,sections:[...auto.sections,{composition:'signature.stamp'}]};assert.deepEqual(layout(auto),layout(decor),'Decorative additions do not inflate main layout counts');const structural={...auto,sections:auto.sections.map(s=>s.composition==='services.disclosure'?{composition:'services.staggered'}:s)};assert.notDeepEqual(layout(auto),layout(structural));
assert.ok(assess({...capture,mobile:undefined},expected).qualityErrors.includes('mobile not checked'));
assert.ok(assess({...capture,mobile:{...capture.mobile!,scrollWidth:391}},expected).qualityErrors.includes('mobile horizontal overflow'));
const ref=await templateReference('4');assert.match(ref,/"align": "center"/);assert.ok(ref.includes('Keep the hero composition'));assert.ok(!ref.includes(doc.meta.businessName));const graphicRef=await templateReference('6');assert.match(graphicRef,/"graphicSide": "right"/);assert.ok(!graphicRef.includes('Clear Pipe'));const hostile=structuredClone(doc);hostile.sections[1].props.statement='PRIVATE_COPY_MARKER';hostile.sections[1].props.contact='PRIVATE_CONTACT_MARKER';assert.ok(!templateLayoutReference(hostile).includes('PRIVATE_'),'Do not forward example copy or unknown content fields');
assert.match(creationUser('A fictional business','soft-clay'),/centre-led introduction/);assert.ok(!creationUser('A fictional business','clear-product').includes('centre-led introduction'));assert.match(creationUser('A fictional business','clear-product'),/Put service selection in the offering section below/);assert.ok(!creationUser('A fictional business','studio-grid').includes('Put service selection in the offering section below'));assert.equal(creationUser('A fictional business'),'A fictional business','Automatic design has no selected style imposed');
console.log('PASS selected-template alignment/primary structure, independent colour/type versus layout metrics, decorative isolation, missing/mobile overflow flags. No AI calls.');
