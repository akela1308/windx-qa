import assert from 'node:assert/strict';import {mkdtemp,readFile,rm,stat,readdir} from 'node:fs/promises';import os from 'node:os';import path from 'node:path';import {randomUUID} from 'node:crypto';
import {analyseSearch,searchFingerprint,searchHtmlHash} from '../src/lib/search/analyse';import {blocksGoogleRoot,hasGoogleNoindex} from '../src/lib/search/robots';import {emptyProbe,probePublic,searchPublicUrl} from '../src/lib/search/probe';import {signSearchEvidence,verifySearchEvidence} from '../src/lib/search/signature';import {SearchSnapshotSchema,type SearchSnapshot,type SearchEvidence} from '../src/lib/search/types';import {FileSiteStore} from '../src/lib/storage/file-store';import {OwnedSiteStore} from '../src/lib/storage/owned-store';import {SearchCheckLimit} from '../src/lib/search/files';import type {Site,SiteVersion} from '../src/lib/storage/types';
const root=await mkdtemp(path.join(os.tmpdir(),'windx-search-'));process.env.WINDX_DATA_DIR=root;delete process.env.WINDX_SEARCH_HTTP;
try {
 const doc=JSON.parse(await readFile('docs/experiment-1c/outputs/bike/light.json','utf8'));doc.factsToConfirm=[];
 const site:Site={id:'search-one',ownerId:'owner',name:'Test',brief:'Private',createdAt:'now',updatedAt:'now',currentVersion:2,versionCount:2,facts:{},published:{slug:'search-one',version:1,at:'2026-10-30T12:00:00.000Z'}};
 const version={n:1,doc} as SiteVersion,url='https://search-one.windx.app/';
 const probe={...emptyProbe('none'),status:200,type:'text/plain'};
 const evidence:SearchEvidence={id:randomUUID(),at:Date.now(),siteId:site.id,target:'published',version:1,url,fingerprint:searchFingerprint(site,version,'published',url),htmlHash:searchHtmlHash('html'),page:{...probe,version:'1',publication:site.published!.at},robots:{...probe,body:'User-agent: *\nAllow: /'},sitemap:{...probe,type:'application/xml',body:'xml'},source:'http'};
 const snapshot:SearchSnapshot={title:'Real page title',titleCount:1,description:'What the business offers in London.',descriptionCount:1,lang:'en-GB',h1:[{section:1,text:'Real headline'}],robots:[],canonicals:[url],links:[{section:0,href:'#contact',targetExists:true}],jsonld:[JSON.stringify({'@context':'https://schema.org','@graph':[{'@type':'WebSite',name:'Test'},{'@type':'Restaurant',name:'Test',address:{'@type':'PostalAddress',streetAddress:'1 Test Street',addressLocality:'London'}}]})],text:'English page content',missingAlt:0,sitemap:{valid:true,locations:[url],limited:false},limited:false};
