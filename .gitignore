# Зависимости
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Тесты
/coverage

# Сборка Next.js
/.next/
/out/
/build

# Прочее
.DS_Store
*.pem
# Открытый ключ шифрования резервов; закрытый остаётся в /data.
!/ops/backup-public-key.pem

# Логи
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Переменные окружения (ключи API, пароли). Никогда не коммитим.
.env*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Supabase (локальные временные файлы)
supabase/.temp
supabase/.branches

# Личные настройки Claude Code
.claude/settings.local.json

# Локальные данные кабинета (сайты и версии), пока нет базы
/data

# скриншоты автотеста кабинета
/[0-9]-*.png

# QA local runtime and package cache
/data-qa
/.npm-cache
