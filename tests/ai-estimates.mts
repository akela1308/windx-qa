import assert from 'node:assert/strict';import {mkdtemp,readFile,rm} from 'node:fs/promises';import os from 'node:os';import path from 'node:path';
import {planCreation,planEdit} from '../src/lib/ai/operation-plan';import {cancelEstimate,issueEstimate,estimateMatches,withAiConsent,readReceipt} from '../src/lib/ai/consent';import {AiConsentError} from '../src/lib/ai/estimate-types';import {getProvider} from '../src/lib/ai/provider';import {authFile} from '../src/lib/auth/account-store';import {DEFAULT_MODEL,DEFAULT_SMALL_MODEL} from '../src/lib/ai/openrouter';
const root=await mkdtemp(path.join(os.tmpdir(),'windx-ai-estimates-'));const previous={...process.env},oldFetch=globalThis.fetch;Object.assign(process.env,{WINDX_DATA_DIR:root,OPENROUTER_API_KEY:'synthetic-test-key',AI_DEMO:'0'});let calls=0;
globalThis.fetch=async()=>{calls++;return Response.json({choices:[{message:{content:'{}'}}],usage:{prompt_tokens:10,completion_tokens:20,cost:0}});};
try{
 const brief='Bike workshop in London, real customer brief not to store in quote';const auto=await planCreation(brief,undefined,'en'),chosen=await planCreation(brief,'newsprint','en');assert.equal(auto.summary.requestsMax,2);assert.equal(chosen.summary.requestsMax,2);assert.equal(auto.summary.outputMax,32000);assert.equal(chosen.summary.outputMax,32000);assert.ok(auto.summary.inputHigh>auto.summary.inputLow);assert.equal(calls,0);
 const estimate=await issueEstimate('owner',chosen);assert.equal(await estimateMatches(estimate.id,'owner',chosen),true);assert.equal(await estimateMatches(estimate.id,'other',chosen),false);assert.equal(await estimateMatches('../bad','owner',chosen),false);assert.equal(await estimateMatches(estimate.id,'owner',await planCreation(brief+' changed','newsprint','en')),false);assert.equal(await estimateMatches(estimate.id,'owner',await planCreation(brief,'newsprint','ru')),false);
 process.env.AI_MODEL='different-model';assert.equal(await estimateMatches(estimate.id,'owner',await planCreation(brief,'newsprint','en')),false);delete process.env.AI_MODEL;
 const cancelled=await issueEstimate('owner',chosen);await cancelEstimate(cancelled.id,'other');assert.equal(await estimateMatches(cancelled.id,'owner',chosen),true);await cancelEstimate(cancelled.id,'owner');assert.equal(await estimateMatches(cancelled.id,'owner',chosen),false);assert.equal(calls,0);
 const expired=await issueEstimate('owner',chosen,Date.now()-16*60_000);assert.equal(await estimateMatches(expired.id,'owner',chosen),false);
 await assert.rejects(()=>getProvider().complete({system:'s',user:'u',fixtureKey:''}),AiConsentError);assert.equal(calls,0);
 const request={system:'s',user:'u',fixtureKey:'',maxTokens:16000};
 const result=await withAiConsent(estimate.id,'owner',chosen,async()=>{const provider=getProvider();await provider.complete(request);await provider.complete(request);await assert.rejects(()=>provider.complete(request),AiConsentError);return 'done';});assert.equal(result.result,'done');assert.equal(calls,2);assert.equal(result.receipt.inputTokens,20);assert.equal(result.receipt.outputTokens,40);assert.equal(result.receipt.unknownRequests,0);assert.equal(result.receipt.requests,2);await assert.rejects(()=>withAiConsent(estimate.id,'owner',chosen,async()=>{}),AiConsentError);assert.equal(calls,2);
 const raw=await readFile(authFile('ai-estimates',estimate.id),'utf8');assert.ok(!raw.includes(brief));assert.ok(!raw.includes('synthetic-test-key'));assert.ok(raw.includes('complete'));assert.equal(await readReceipt(estimate.id,'other'),undefined);
 const concurrent=await issueEstimate('owner',chosen);const race=await Promise.allSettled(Array.from({length:6},()=>withAiConsent(concurrent.id,'owner',chosen,async()=>getProvider().complete(request))));assert.equal(race.filter(r=>r.status==='fulfilled').length,1);assert.equal(calls,3);
 const wrong=await issueEstimate('owner',chosen);await withAiConsent(wrong.id,'owner',chosen,async()=>{await assert.rejects(()=>getProvider().complete({...request,model:'other-model'}),AiConsentError);await assert.rejects(()=>getProvider().complete({...request,maxTokens:16001}),AiConsentError);await assert.rejects(()=>getProvider().complete({...request,user:'x'.repeat(chosen.steps[0].inputBytes+1)}),AiConsentError);});assert.equal(calls,3);
 const style=await issueEstimate('owner',auto);await withAiConsent(style.id,'owner',auto,async()=>{await assert.rejects(()=>getProvider().complete({...request,model:DEFAULT_SMALL_MODEL,maxTokens:200}),AiConsentError);await getProvider().complete({...request,model:DEFAULT_MODEL});await getProvider().complete({...request,model:DEFAULT_MODEL});});assert.equal(calls,5);
 const failed=await issueEstimate('owner',chosen);globalThis.fetch=async()=>{calls++;throw new Error('timeout');};await assert.rejects(()=>withAiConsent(failed.id,'owner',chosen,async()=>getProvider().complete(request)));const receipt=await readReceipt(failed.id,'owner');assert.equal(receipt?.unknownRequests,1);assert.equal(receipt?.requests,1);assert.equal(receipt?.inputTokens,0);assert.equal(JSON.parse(await readFile(authFile('ai-estimates',failed.id),'utf8')).status,'failed');
 const doc=JSON.parse(await readFile('docs/experiment-1c/outputs/bike/light.json','utf8'));const edit=await planEdit(brief,doc,'Only change section 1 (hero.type-poster). Remove underline','ru',1,'site-one');assert.equal(edit.summary.outputMax,16000);assert.equal(edit.summary.requestsMax,2);assert.equal(edit.summary.includesStyle,false);assert.notEqual(edit.fingerprint,(await planEdit(brief,doc,'Only change section 2 (hero.type-poster). Remove underline','ru',1,'site-one')).fingerprint);assert.notEqual(edit.fingerprint,(await planEdit(brief,doc,'Only change section 1 (hero.type-poster). Remove underline','ru',2,'site-one')).fingerprint);
 process.env.AI_DEMO='1';const demo=await planCreation(brief,undefined,'en');assert.equal(demo.summary.demo,true);assert.notEqual(demo.fingerprint,auto.fingerprint);const de=await issueEstimate('owner',demo),before=calls;const dr=await withAiConsent(de.id,'owner',demo,async()=>getProvider().complete({...request,fixtureKey:'experiment-1c/outputs/bike/light.json'}));assert.equal(dr.receipt.requests,0);assert.equal(dr.receipt.demo,true);assert.equal(calls,before);
 console.log('PASS: no AI preflight, actual prompt/model/style/version/language fingerprint, full retry/style plan, owner/expiry/replay/concurrent protection, provider cannot run without consent or exceed approved request/input/output/model plan, durable known/unknown usage, no prompts or keys in receipts, demo no external AI. All provider responses mocked.');
}finally{globalThis.fetch=oldFetch;process.env=previous;await rm(root,{recursive:true,force:true});}
