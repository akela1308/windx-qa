import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {WorksCheckLimit} from '../src/lib/checks/files';
import {mkdtemp,readFile,rm,stat} from 'node:fs/promises';
import os from 'node:os';import path from 'node:path';
import {analyseWorks,worksFingerprint} from '../src/lib/checks/analyse';
import {FileSiteStore} from '../src/lib/storage/file-store';
import {OwnedSiteStore} from '../src/lib/storage/owned-store';
import {BrowserScanSchema,type BrowserScan} from '../src/lib/checks/types';
import type {Site,SiteVersion} from '../src/lib/storage/types';
import {renderDoc} from '../src/lib/design/render';
import {SiteDocSchema} from '../experiments/exp1/a/schema';
const root=await mkdtemp(path.join(os.tmpdir(),'windx-works-'));
try {
 const doc=JSON.parse(await readFile('docs/experiment-1c/outputs/bike/light.json','utf8'));
 doc.factsToConfirm=[{fact:'CONFIDENTIAL_FACT',where:'Contact'}];
 const site:Site={id:'one',ownerId:'owner',name:'one',brief:'private',createdAt:'now',updatedAt:'now',currentVersion:1,versionCount:1,facts:{}};
 const version={n:1,doc} as SiteVersion;
 const scan:BrowserScan={width:1200,headings:[{section:1,text:''},{section:2,text:'Services'},{section:3,text:'Services'}],links:[{section:0,label:'Missing',href:'#missing',targetExists:false},{section:0,label:'Top',href:'#',targetExists:true},{section:2,label:'Page',href:'/about',targetExists:true},{section:2,label:'Bad',href:'javascript:alert(1)',targetExists:true},{section:2,label:'Example',href:'mailto:owner@example.test',targetExists:true},{section:0,label:'Real web',href:'https://example.org/',targetExists:true},{section:0,label:'Root query',href:'/?filter=a',targetExists:true}],duplicateIds:['contact'],missingAlt:[2],overflow:[],smallTargets:[],contrasts:[],fontsReady:true,truncated:false};
 const mobile={...scan,width:390,links:[...scan.links,{section:4,label:'Mobile-only link',href:'#mobile-missing',targetExists:false}],overflow:[1],smallTargets:[0],contrasts:[{section:1,text:'Faint text',ratio:1.1,min:4.5}]};
 const report=analyseWorks(site,version,renderDoc(doc),[scan,mobile],'ru');
 const codes=report.findings.map(f=>f.code);
 for(const code of ['brokenLink','unsafeLink','invalidContact','emptyHeading','duplicateHeading','duplicateId','alt','overflow','target','contrast','unconfirmed'])assert.ok(codes.includes(code as typeof codes[number]),code);
 assert.equal(report.findings.filter(f=>f.code==='brokenLink').length,3);
 assert.equal(report.findings.find(f=>f.code==='duplicateHeading')?.confidence,'possible');
 assert.equal(report.findings.find(f=>f.code==='emptyHeading')?.source,'browser');
 assert.equal(report.externalLinks,1);assert.equal(report.browser,true);
 assert.ok(report.findings.findIndex(f=>f.priority==='high')<report.findings.findIndex(f=>f.priority==='low'));
 assert.ok(!BrowserScanSchema.safeParse({...scan,links:Array(251).fill(scan.links[0])}).success);
 assert.ok(!BrowserScanSchema.safeParse({...scan,contrasts:[{section:1,text:'x',ratio:100,min:4.5}]}).success);
 const photoDoc=structuredClone(doc);
 const hero=photoDoc.sections.findIndex((s:{composition:string})=>s.composition.startsWith('hero.'));
 photoDoc.sections[hero]={composition:'hero.band',tone:'default',props:{headline:'Photo test',cta:{label:'Contact',href:'#contact'},photos:[{subject:'Front of workshop'},{subject:'Workshop team'}],facts:[]}};
 photoDoc.sections.push({composition:'gallery.mosaic',tone:'default',props:{photos:[{subject:'Work one'},{subject:'Work two'},{subject:'Work three'}]}},{composition:'contact.split',tone:'default',props:{title:'Visit',address:'Test address',hours:[],entrance:{subject:'Street entrance'}}});
 const parsedPhotos=SiteDocSchema.parse(photoDoc),photoHtml=renderDoc(parsedPhotos);
 assert.equal((photoHtml.match(/class="ph(?:\s|")/g)??[]).length,6);
 assert.equal(analyseWorks(site,{...version,doc:parsedPhotos},photoHtml,[],'en').findings.filter(f=>f.code==='photo').length,6);
 const old=worksFingerprint(site,version);
 assert.notEqual(worksFingerprint({...site,facts:{CONFIDENTIAL_FACT:'confirmed'}},version),old);
 assert.notEqual(worksFingerprint({...site,enquiryRecipient:{email:'owner@example.test',confirmedAt:'now'}},version),old);
 assert.notEqual(worksFingerprint({...site,published:{slug:'one',version:1,at:'now'}},version),old);
 assert.notEqual(worksFingerprint(site,{...version,n:2}),old);
 const noBrowser=analyseWorks(site,version,renderDoc(doc),[],'en');assert.equal(noBrowser.browser,false);assert.ok(!noBrowser.findings.some(f=>f.code==='overflow'));
 const large=analyseWorks(site,version,'x'.repeat(201*1024),[],'en');assert.equal(large.findings.find(f=>f.code==='weight')?.confidence,'possible');
 const raw=new FileSiteStore(root);await raw.saveSite(site);
 const owner=new OwnedSiteStore(raw,'owner'),foreign=new OwnedSiteStore(raw,'foreign'),visitor=new OwnedSiteStore(raw,null);
 await owner.saveWorksReport(site.id,report);assert.equal((await owner.listWorksReports(site.id))[0].fingerprint,old);
 for(const store of [foreign,visitor]){await assert.rejects(store.listWorksReports(site.id));await assert.rejects(store.saveWorksReport(site.id,report));}
 const files=await import('node:fs/promises');const names=await files.readdir(path.join(root,'sites/one/checks/works'));assert.equal((await stat(path.join(root,'sites/one/checks/works',names[0]))).mode&0o777,0o600);
 const guest=new OwnedSiteStore(raw,'owner',true);await guest.saveWorksReport(site.id,{...report,id:'abcdefab-cdef-abcd-abcd-abcdefabcdef',at:'2026-10-30T19:00:00.000Z'});
 await raw.saveSite({...site,published:{slug:'one',version:1,at:'now'}});await assert.rejects(guest.saveWorksReport(site.id,report));
 assert.equal((await owner.listWorksReports(site.id)).length,2);
 await raw.saveSite({...site,id:'limited'});
 for(let i=0;i<29;i++)await raw.saveWorksReport('limited',{...report,id:randomUUID(),at:new Date().toISOString()});
 const attempts=await Promise.allSettled(Array.from({length:10},()=>raw.saveWorksReport('limited',{...report,id:randomUUID(),at:new Date().toISOString()})));
 assert.equal(attempts.filter(r=>r.status==='fulfilled').length,1);
 assert.ok(attempts.filter(r=>r.status==='rejected').every(r=>r.status==='rejected' && r.reason instanceof WorksCheckLimit));
 console.log('PASS: internal links, contacts, headings, IDs, alt, mobile overflow, contrast, uncertainty, HTML size, browser failure, fingerprints, private report history and guest/foreign ownership');
} finally {await rm(root,{recursive:true,force:true});}
