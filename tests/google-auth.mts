import assert from "node:assert/strict";
import { mkdtemp, readFile, writeFile, rm } from "node:fs/promises";
import path from "node:path";
import os from "node:os";
import { createHash } from "node:crypto";
import type { TokenPayload } from "google-auth-library";
import { authenticate, googleAccount, registerAccount } from "../src/lib/auth/accounts";
import { authOrigin, checkedGoogleClaims, consumeGoogleFlow, startGoogleFlow } from "../src/lib/auth/google";

const root = await mkdtemp(path.join(os.tmpdir(), "windx-google-test-"));
process.env.WINDX_DATA_DIR = root;
process.env.GOOGLE_CLIENT_ID = "test-client.apps.googleusercontent.com";
process.env.GOOGLE_CLIENT_SECRET = "synthetic-test-secret";
process.env.WINDX_AUTH_ORIGIN = "https://www.windx.app";
try {
  const flow = await startGoogleFlow("user-a");
  const url = new URL(flow.url);
  assert.equal(url.origin, "https://accounts.google.com");
  assert.equal(url.searchParams.get("redirect_uri"), "https://www.windx.app/auth/google/callback");
  assert.equal(url.searchParams.get("code_challenge_method"), "S256");
  assert.equal(url.searchParams.get("scope"), "openid email");
  const state = await consumeGoogleFlow(flow.state);
  assert.equal(state.linkUserId, "user-a");
  assert.equal(createHash("sha256").update(state.verifier).digest("base64url"), url.searchParams.get("code_challenge"));
  await assert.rejects(consumeGoogleFlow(flow.state));
  await assert.rejects(consumeGoogleFlow("../../arbitrary"));
  const expired = await startGoogleFlow();
  const stateFile = path.join(root, "auth", "oauth", `${createHash("sha256").update(expired.state).digest("hex")}.json`);
  const stored = JSON.parse(await readFile(stateFile, "utf8"));
  await writeFile(stateFile, JSON.stringify({ ...stored, expires: 0 }));
  await assert.rejects(consumeGoogleFlow(expired.state));
  const claims = { iss: "https://accounts.google.com", aud: process.env.GOOGLE_CLIENT_ID, sub: "subject-a", email: "a@example.test", email_verified: true, nonce: "nonce-a", iat: Math.floor(Date.now() / 1000), exp: Math.floor(Date.now() / 1000) + 600 } satisfies TokenPayload;
  assert.equal(checkedGoogleClaims(claims, "nonce-a").sub, "subject-a");
  for (const bad of [{ email_verified: false }, { nonce: "wrong" }, { aud: "another-client" }, { iss: "https://evil.example" }, { exp: 0 }, { exp: NaN }, { sub: "" }]) assert.throws(() => checkedGoogleClaims({ ...claims, ...bad }, "nonce-a"));
  const googleOnly = await googleAccount("google-new", "new@example.test");
  assert.equal((await googleAccount("google-new", "new@example.test")).id, googleOnly.id);
  assert.equal(await authenticate("new@example.test", "no-password"), null);
  const passwordUser = await registerAccount("password@example.test", "password-test-long-123");
  await assert.rejects(googleAccount("google-password", "password@example.test"));
  await assert.rejects(googleAccount("google-password", "password@example.test", "another-user"));
  assert.equal((await googleAccount("google-password", "password@example.test", passwordUser.id)).id, passwordUser.id);
  assert.equal((await googleAccount("google-password", "password@example.test")).id, passwordUser.id);
  assert.equal((await authenticate("password@example.test", "password-test-long-123"))?.id, passwordUser.id);
  await assert.rejects(googleAccount("another-google", "password@example.test"));
  await assert.rejects(googleAccount("google-password", "password@example.test", googleOnly.id));
  process.env.WINDX_AUTH_ORIGIN = "https://evil.example/path";
  assert.throws(authOrigin);
  console.log("PASS: OAuth state one-time/expiry, PKCE, nonce/audience/issuer/verified-email checks, stable account IDs, explicit safe linking, password preservation; no Google API calls");
} finally { await rm(root, { recursive: true, force: true }); }
