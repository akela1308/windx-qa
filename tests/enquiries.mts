    assert.match(preview,/<fieldset disabled=""/);assert.match(preview,/Preview only/);
    assert.ok(!preview.includes('fetch(f.action'));
    assert.match(live,/data-windx-enquiry="live"/);assert.match(live,/action="\/_enquiry"/);
    assert.match(live,/Ask &lt;anything&gt;/);assert.match(live,/private inbox/);
