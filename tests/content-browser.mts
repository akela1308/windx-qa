import assert from 'node:assert/strict';
import {spawn} from 'node:child_process';
import {mkdtemp,readFile,rm,mkdir} from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import sharp from 'sharp';
import {chromium} from 'playwright';
import {createSession} from '../src/lib/auth/accounts';
import {FileSiteStore} from '../src/lib/storage/file-store';
import type {SiteVersion} from '../src/lib/storage/types';
const root=await mkdtemp(path.join(os.tmpdir(),'windx-content-browser-'));
process.env.WINDX_DATA_DIR=root;
const raw=new FileSiteStore(root),now=new Date().toISOString(),port=3214,base=`http://127.0.0.1:${port}`,id='browser-content';
const doc=JSON.parse(await readFile('docs/experiment-1c/outputs/yoga/light.json','utf8'));doc.factsToConfirm=[];
await raw.saveSite({id,ownerId:'owner',name:'Manual editing browser test',brief:'demo',facts:{},currentVersion:1,versionCount:1,createdAt:now,updatedAt:now});
await raw.addVersion(id,{n:1,createdAt:now,action:'create',request:'demo',reply:'demo',doc,demo:true,usage:{inputTokens:0,outputTokens:0,costUsd:0,estimated:false}} as SiteVersion);
const token=await createSession({id:'owner',email:'owner@example.test'});
const server=spawn(process.execPath,['node_modules/next/dist/bin/next','start','--hostname','127.0.0.1','--port',String(port)],{env:{...process.env,AI_DEMO:'1',NODE_ENV:'production'},stdio:'pipe'});
let logs='';server.stdout.on('data',d=>logs+=d);server.stderr.on('data',d=>logs+=d);
let browser:Awaited<ReturnType<typeof chromium.launch>>|undefined;
try {
  for(let i=0;i<100;i++){try{if((await fetch(base+'/login')).status===200)break;}catch{}if(server.exitCode!==null)throw Error(logs);await new Promise(r=>setTimeout(r,100));}
  browser=await chromium.launch({headless:true});
  const context=await browser.newContext({viewport:{width:1440,height:1000},extraHTTPHeaders:{cookie:`__Host-windx_session=${token}; windx_lang=ru`}});
  const page=await context.newPage();const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));
  await page.goto(base+`/sites/${id}`);
  await page.getByRole('tab',{name:'Текст и изображения',exact:true}).click();
  const panel=page.getByRole('tabpanel');
  const hero=doc.sections.findIndex((s:{composition:string})=>s.composition==='hero.split-photo');
  await panel.getByRole('combobox').first().selectOption(String(hero));
  await panel.getByRole('textbox',{name:'Главный заголовок',exact:true}).fill('Владелец написал этот заголовок');
  page.once('dialog',d=>d.dismiss());await page.getByRole('tab',{name:'История',exact:true}).click();
  assert.equal(await page.getByRole('tab',{name:'Текст и изображения',exact:true}).getAttribute('aria-selected'),'true');
  page.once('dialog',d=>d.dismiss());await page.getByRole('link',{name:'Мои сайты',exact:true}).click();
  assert.ok(page.url().endsWith(`/sites/${id}`));
  assert.equal(await panel.getByRole('textbox',{name:'Главный заголовок',exact:true}).inputValue(),'Владелец написал этот заголовок');
  const buffer=await sharp({create:{width:900,height:600,channels:4,background:'#bd552f'}}).png().toBuffer();
  await panel.locator('input[type=file]').first().setInputFiles({name:'my-studio.png',mimeType:'image/png',buffer});
  await panel.getByText('Изображение загружено.',{exact:false}).waitFor();
  await panel.getByLabel('Описание изображения',{exact:true}).first().fill('Наш настоящий зал');
  await panel.getByLabel('Кадрирование',{exact:true}).selectOption('contain');
  await panel.getByRole('button',{name:'Посмотреть изменения',exact:true}).click();
  await panel.getByRole('button',{name:'Применить изменения',exact:true}).waitFor();
  assert.equal((await raw.getSite(id))?.currentVersion,1);
  await panel.getByRole('button',{name:'Применить изменения',exact:true}).click();
  await page.waitForFunction(()=>document.querySelector('iframe')?.getAttribute('src')?.includes('/2?edit=1'));
  const frame=page.frameLocator('iframe[title*="version"]');
  assert.equal(await frame.locator('h1').innerText(),'Владелец написал этот заголовок');
  const image=frame.getByRole('img',{name:'Наш настоящий зал',exact:true});
  await image.waitFor();await page.waitForFunction(()=>{const f=document.querySelector('iframe');return !!f?.contentDocument?.querySelector<HTMLImageElement>('img[alt="Наш настоящий зал"]')?.naturalWidth;});
  await page.reload();await page.getByRole('tab',{name:'Текст и изображения',exact:true}).click();
  await panel.getByRole('combobox').first().selectOption('-2');
  await panel.locator('input[type=file]').setInputFiles({name:'extra.png',mimeType:'image/png',buffer});
  await panel.getByText('Изображение загружено.',{exact:false}).waitFor();
  await panel.getByLabel('Описание изображения',{exact:true}).fill('Дополнительное фото');
  await panel.getByRole('button',{name:'Посмотреть изменения',exact:true}).click();
  await panel.getByRole('button',{name:'Применить изменения',exact:true}).click();
  await page.waitForFunction(()=>document.querySelector('iframe')?.getAttribute('src')?.includes('/3?edit=1'));
  assert.equal((await raw.getVersion(id,3))?.doc.sections.filter(s=>s.composition==='media.image').length,1);
  await page.getByRole('tab',{name:'Текст и изображения',exact:true}).click();
  await mkdir('data/verification',{recursive:true});await page.screenshot({path:'data/verification/manual-editor-desktop-2026-10-31.png'});
  await page.setViewportSize({width:390,height:844});
  assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth),390);
  await page.screenshot({path:'data/verification/manual-editor-mobile-2026-10-31.png'});
  assert.deepEqual(errors,[]);
  console.log('PASS: Russian manual editor UI, unsaved-change warning, own upload/alt/framing, review/apply/persistence, real preview image, standalone photo insertion, desktop/mobile and no browser errors');
} catch(e){console.error(logs.slice(-2000));throw e;} finally {await browser?.close();server.kill('SIGTERM');if(server.exitCode===null)await new Promise<void>(r=>server.once('exit',()=>r()));await rm(root,{recursive:true,force:true});}
