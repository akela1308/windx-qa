import assert from 'node:assert/strict';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import { ImageField } from '../src/components/editor/ImageField';
import { mkdtemp, readFile, rm } from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import sharp from 'sharp';
import { contentSections, writeField } from '../src/lib/content/fields';
import { saveImage, readImage, duplicateImages } from '../src/lib/media/files';
import { mediaRefs } from '../src/lib/media/refs';
import { describeContentChanges, validateEditDoc } from '../src/lib/sites/edit-review';
import { validateDoc } from '../src/lib/design';
import { renderDoc } from '../src/lib/design/render';
import { PhotoSchema } from '../experiments/exp1/a/parts';
const root = await mkdtemp(path.join(os.tmpdir(), 'windx-content-'));
process.env.WINDX_DATA_DIR = root;
try {
  const doc = JSON.parse(await readFile('docs/experiment-1c/outputs/yoga/light.json','utf8'));
  const sections = contentSections(doc);
  assert.equal(sections[0].index, -1);
  assert.ok(sections.find(s => s.composition.startsWith('header.'))!.fields.some(f => f.path === 'logo' && f.kind === 'photo' && !f.required));
  assert.ok(sections.some(s => s.fields.some(f => f.kind === 'photo' && f.required)));
  for (const section of sections) for (const f of section.fields) {
    assert.ok(!/photoSide|align|\.src|\.fit|paths|svg/.test(f.path),f.path);
    if (f.kind !== 'photo') assert.equal(typeof f.value,'string');
  }
  const taggedInput = await sharp({create:{width:2600,height:1000,channels:4,background:'#e85632'}}).withMetadata({exif:{IFD0:{Artist:'WINDX synthetic QA marker'}}}).png().toBuffer();
  assert.ok((await sharp(taggedInput).metadata()).exif, 'Input must contain metadata for the stripping check');
  const src = await saveImage('original', taggedInput);
  const imageField = sections.find(s=>s.fields.some(f=>f.kind==='photo'))!.fields.find(f=>f.kind==='photo')!;
  const fieldProps={field:imageField,value:{src,subject:'Owner photograph'},onChange:()=>{},siteId:'original',locale:'en',setBusy:()=>{}};
  const preparing=renderToStaticMarkup(createElement(ImageField,{...fieldProps,busy:false,pending:true}));
  assert.match(preparing,/Preparing preview/);assert.ok(!preparing.includes('Uploading…'));
  const controls=[...preparing.matchAll(/<(?:input|select|button)\b[^>]*>/g)].map(m=>m[0]);
  assert.ok(controls.length>=5);assert.ok(controls.every(html=>html.includes('disabled=""')));
  const uploading=renderToStaticMarkup(createElement(ImageField,{...fieldProps,busy:true,pending:false}));
  assert.match(uploading,/Uploading…/);assert.ok(!uploading.includes('Preparing preview'));
  const bytes = await readImage(src), info = await sharp(bytes).metadata();
  assert.equal(info.format,'webp');assert.equal(info.width,2400);assert.equal(info.exif,undefined);
  await assert.rejects(saveImage('original', Buffer.from('<svg xmlns="http://www.w3.org/2000/svg"/>')));
  await assert.rejects(saveImage('original', Buffer.alloc(8*1024*1024+1)));
  await assert.rejects(readImage('/media/../../etc/passwd'));
  const next = structuredClone(doc), slot=sections.find(s=>s.fields.some(f=>f.kind==='photo'&&f.required))!;
  writeField(next.sections[slot.index].props, slot.fields.find(f=>f.kind==='photo'&&f.required)!.path, {src,subject:'Owner photograph',fit:'contain'});
  next.sections[0].props.logo={src,subject:'Owner logo'};
  assert.ok(validateDoc(next).ok);
  assert.match(renderDoc(next), /alt="Owner photograph"/);assert.match(renderDoc(next), /class="brand-logo"/);
  assert.deepEqual(mediaRefs(next),[src]);
  const copy = await duplicateImages(next,'original','copy');
  assert.ok(mediaRefs(copy)[0].startsWith('/media/copy/'));assert.deepEqual(await readImage(mediaRefs(copy)[0]),bytes);
  await rm(path.join(root,'sites','original'),{recursive:true,force:true});
  assert.deepEqual(await readImage(mediaRefs(copy)[0]),bytes);
  assert.equal(validateEditDoc(next,doc).ok,false);
  assert.equal(validateEditDoc(copy,copy).ok,true);
  const inserted = structuredClone(copy);
  inserted.sections.splice(inserted.sections.length - 1, 0, { id: 'image-new', composition: 'media.image', tone: 'default', props: { photo: { subject: 'Added', src: mediaRefs(copy)[0] } } });
  const diff = describeContentChanges(copy, inserted);
  assert.equal(diff.length, 1);assert.equal(diff[0].area,'media');
  assert.equal(PhotoSchema.safeParse({subject:'x',src:'https://evil.test/x.png'}).success,false);
  console.log('PASS: schema-derived text/links, optional logos, real photos, safe re-encoding/resize, bad format/size/traversal rejection, copy survives original deletion and AI cannot invent image references');
} finally {await rm(root,{recursive:true,force:true});}
