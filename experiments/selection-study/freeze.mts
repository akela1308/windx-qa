import{readFile,writeFile}from'node:fs/promises';
import{getDirection}from'../exp1/a/directions';
const root='data/verification/selection-study-2026-11-04';
const cases=JSON.parse(await readFile('experiments/selection-study/cases.json','utf8')) as {id:string;style:string;template?:string}[];
const expectations=await Promise.all(cases.map(async c=>{const file=`docs/catalog/${c.template!==undefined?'template-'+c.template:c.style}.json`,doc=JSON.parse(await readFile(file,'utf8'));const h=doc.sections.find((s:{composition:string})=>s.composition.startsWith('hero.'));const p=doc.sections.find((s:{composition:string})=>s.composition.startsWith('services.')&&s.composition!=='services.cta-band');return {caseId:c.id,direction:getDirection(c.style),reference:{source:file,hero:h.composition,...(h.props.align?{align:h.props.align}:{}),...(h.props.graphicSide?{graphicSide:h.props.graphicSide}:{}),primaryService:p.composition,sequence:doc.sections.map((s:{composition:string})=>s.composition)}};}));
const file=`${root}/expectations.json`;const text=JSON.stringify({sourceCommit:'f1e16c0',cases:expectations},null,2)+'\n';const old=await readFile(file,'utf8').catch((e:{code?:string})=>{if(e.code!=='ENOENT')throw e;return undefined;});if(old!==undefined&&old!==text)throw Error('Expectations already frozen; retain original source.');await writeFile(file,text);console.log('Reference layouts and direction limits frozen. No AI calls.');
