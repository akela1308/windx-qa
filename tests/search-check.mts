 for(const code of ['title','description','h1','language','canonical','jsonInvalid','localMissing','brokenLink','alt','noindex','crawlBlocked','sitemapInvalid'])assert.ok(bad.findings.some(f=>f.code===code),code);
 assert.equal(bad.findings.find(f=>f.code==='h1')?.confidence,'possible');
 const absent=analyseSearch(site,version,{...evidence,robots:{...probe,status:404},sitemap:{...probe,status:404}},snapshot);assert.equal(absent.findings.find(f=>f.code==='robotsUnavailable')?.priority,'low');assert.equal(absent.findings.find(f=>f.code==='sitemapUnavailable')?.priority,'low');
 const unknown=analyseSearch(site,version,{...evidence,source:'generated',page:emptyProbe('disabled'),robots:emptyProbe('disabled'),sitemap:emptyProbe('disabled')},null);assert.equal(unknown.unavailable,true);assert.equal(unknown.browser,false);assert.ok(!unknown.passed.includes('http')&&!unknown.passed.includes('indexDirective'));assert.ok(unknown.findings.some(f=>f.code==='snapshot'));
 assert.ok(!analyseSearch(site,version,{...evidence,source:'generated',page:{...evidence.page,robots:'noindex'}},snapshot).findings.some(f=>f.code==='noindex'));
 const spoof=analyseSearch(site,version,evidence,{...snapshot,jsonld:[JSON.stringify({'@context':'https://untrusted.example','@type':'Restaurant',name:'Fake',address:{streetAddress:'Fake'}})]});assert.ok(!spoof.passed.includes('localData'));
 const partial=analyseSearch(site,version,evidence,{...snapshot,jsonld:[JSON.stringify({'@context':'https://schema.org','@type':'LocalBusiness',name:'Test'})]});assert.ok(partial.findings.some(f=>f.code==='localInvalid'));
 assert.equal(blocksGoogleRoot('User-agent: *\nDisallow: /'),true);assert.equal(blocksGoogleRoot('User-agent: *\nDisallow: /\nAllow: /$'),false);
 assert.equal(blocksGoogleRoot('User-agent: Googlebot\nDisallow:\nUser-agent: *\nDisallow: /'),false);assert.equal(blocksGoogleRoot('User-agent: *\nDisallow: /\nUser-agent: Googlebot\nAllow: /'),false);
 assert.equal(blocksGoogleRoot('User-agent: Googlebot\nDisallow: /private'),false);
 assert.equal(hasGoogleNoindex([], 'otherbot: noindex'),false);assert.equal(hasGoogleNoindex([], 'otherbot: noindex, googlebot: noindex'),true);assert.equal(hasGoogleNoindex(['none'], ''),true);assert.equal(hasGoogleNoindex([], 'max-snippet: 0, noindex'),true);
 assert.notEqual(searchFingerprint(site,{...version,n:2},'draft',url),evidence.fingerprint);assert.notEqual(searchFingerprint({...site,published:undefined},version,'published',url),evidence.fingerprint);
 const signature=await signSearchEvidence(evidence);assert.equal((await verifySearchEvidence(evidence,signature)).siteId,site.id);await assert.rejects(verifySearchEvidence({...evidence,page:{...evidence.page,status:404}},signature));const old={...evidence,at:Date.now()-11*60_000};await assert.rejects(verifySearchEvidence(old,await signSearchEvidence(old)));
 assert.equal((await stat(path.join(root,'auth/search-check-key'))).mode&0o777,0o600);
 assert.ok(!SearchSnapshotSchema.safeParse({...snapshot,jsonld:['x'.repeat(32_001)]}).success);assert.throws(()=>searchPublicUrl('../other'));
 let call=0;const fake:typeof fetch=async(input,init)=>{call++;const u=new URL(String(input));assert.equal(u.origin,url.slice(0,-1));assert.equal(u.pathname,'/robots.txt');assert.equal(init?.redirect,'error');assert.equal(init?.credentials,'omit');assert.equal(init?.cache,'no-store');return new Response('User-agent: *\nAllow: /',{headers:{'content-type':'text/plain'}});};
 assert.equal((await probePublic(new URL(url),'/robots.txt',fake)).status,200);assert.equal(call,1);
 const large:typeof fetch=async()=>new Response('x'.repeat(40_000));assert.equal((await probePublic(new URL(url),'/robots.txt',large)).limited,true);
 const failed:typeof fetch=async()=>{throw Error('Network unavailable');};assert.equal((await probePublic(new URL(url),'/',failed)).error,'unavailable');
 process.env.WINDX_SEARCH_HTTP='0';assert.equal((await probePublic(new URL(url),'/',fake)).error,'disabled');assert.equal(call,1);
 const raw=new FileSiteStore(root);await raw.saveSite(site);const owner=new OwnedSiteStore(raw,'owner'),foreign=new OwnedSiteStore(raw,'foreign'),guest=new OwnedSiteStore(raw,'owner',true);
 const saved=await owner.saveSearchReport(site.id,good);assert.equal(saved.id,good.id);assert.equal((await owner.saveSearchReport(site.id,good)).id,good.id);assert.equal((await owner.listSearchReports(site.id)).length,1);
 await assert.rejects(foreign.listSearchReports(site.id));await assert.rejects(foreign.saveSearchReport(site.id,good));await assert.rejects(guest.saveSearchReport(site.id,good));
 const files=await readdir(path.join(root,'sites/search-one/checks/search'));assert.equal((await stat(path.join(root,'sites/search-one/checks/search',files[0]))).mode&0o777,0o600);
 await raw.saveSite({...site,id:'limited'});for(let i=0;i<29;i++)await raw.saveSearchReport('limited',{...good,id:randomUUID(),at:new Date().toISOString()});const attempts=await Promise.allSettled(Array.from({length:5},()=>raw.saveSearchReport('limited',{...good,id:randomUUID(),at:new Date().toISOString()})));assert.equal(attempts.filter(r=>r.status==='fulfilled').length,1);assert.ok(attempts.filter(r=>r.status==='rejected').every(r=>r.status==='rejected'&&r.reason instanceof SearchCheckLimit));
 console.log('PASS: metadata, h1 policy, language, canonical, noindex and robot groups, optional missing files, LocalBusiness subtypes/context/required data, unavailable fallback, signed/expired evidence, bounded HTTP requests, private/idempotent history and concurrent rate limit');
}finally{await rm(root,{recursive:true,force:true});}
