  assert.equal((await member.listEnquiries(site.id,1))[0].id,'b'.repeat(64));
  assert.equal((await member.listEnquiries(site.id,1,1))[0].id,enquiry.id);
  await member.deleteEnquiry(site.id,enquiry.id);assert.equal((await member.listEnquiries(site.id)).length,1);
